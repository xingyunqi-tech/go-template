{{range .}}{{if not .IsAlias}}
    {{$opid := .OperationId -}}
    {{$status := "http.StatusOK" -}}
    {{if eq (.OperationId | lower) "uploadfile"}}{{$status = "http.StatusCreated"}}{{end -}}
    type {{$opid | ucFirst}}RequestObject struct {
        {{range .PathParams -}}
            {{.GoName | ucFirst}} {{.TypeDef}} {{.JsonTag}}
        {{end -}}
        {{if .RequiresParamObject -}}
            Params {{$opid}}Params
        {{end -}}
        {{if .HasMaskedRequestContentTypes -}}
            ContentType string
        {{end -}}
        {{$multipleBodies := gt (len .Bodies) 1 -}}
        {{range .Bodies -}}
            {{if $multipleBodies}}{{.NameTag}}{{end}}Body {{if eq .NameTag "Multipart"}}*multipart.Reader{{else if ne .NameTag ""}}*{{$opid}}{{.NameTag}}RequestBody{{else}}io.Reader{{end}}
        {{end -}}
    }

    type {{$opid | ucFirst}}ResponseObject interface {
        Visit{{$opid}}Response(w http.ResponseWriter) error
    }

    {{range .Responses}}
        {{$statusCode := .StatusCode -}}
        {{$hasHeaders := ne 0 (len .Headers) -}}
        {{$isRef := .IsRef -}}
        {{$ref := .Ref  | ucFirstWithPkgName -}}
        {{$headers := .Headers -}}

        {{if (and $hasHeaders (not $isRef)) -}}
            type {{$opid}}{{$statusCode}}ResponseHeaders struct {
                {{range .Headers -}}
                    {{.GoName}} {{.GoTypeDef}}
                {{end -}}
            }
        {{end}}

        {{range .Contents}}
            {{$receiverTypeName := printf "%s%s%s%s" $opid $statusCode .NameTagOrContentType "Response"}}
            {{$hasBodyVar := or ($hasHeaders) (not .IsSupported) (not .IsJSON) -}}
            {{if and (not $hasHeaders) (.IsSupported) (.IsJSON) -}}
                type {{$receiverTypeName}} {{if and .Schema.IsRef (not .Schema.IsExternalRef)}}={{end}} {{.Schema.TypeDecl}}
            {{else -}}
                type {{$receiverTypeName}} struct {
                    Body {{if eq .NameTag "Multipart"}}func(writer *multipart.Writer)error{{else if .IsSupported}}{{.Schema.TypeDecl}}{{else}}io.Reader{{end}}
                    {{if $hasHeaders -}}
                        Headers {{if $isRef}}{{$ref}}{{else}}{{$opid}}{{$statusCode}}{{end}}ResponseHeaders
                    {{end -}}
                    {{if not .HasFixedContentType -}}
                        ContentType string
                    {{end -}}
                }
            {{end}}

            func (resp {{$receiverTypeName}}) Visit{{$opid}}Response(w http.ResponseWriter) error {
                {{range $headers -}}
                    {{if .IsOptional -}}
                        if resp.Headers.{{.GoName}} != nil {
                            w.Header().Set("{{.Name}}", fmt.Sprint(*resp.Headers.{{.GoName}}))
                        }
                    {{else -}}
                        w.Header().Set("{{.Name}}", fmt.Sprint(resp.Headers.{{.GoName}}))
                    {{end -}}
                {{end -}}
                {{if .IsJSON -}}
                    return response.WriteData(w, {{$status}}, {{if $hasBodyVar}}resp.Body{{else}}{{.Schema.TypeDecl}}(resp){{end}})
                {{else if eq .NameTag "Multipart" -}}
                    writer := multipart.NewWriter(w)
                    w.Header().Set("Content-Type", writer.FormDataContentType())
                    w.WriteHeader({{$status}})
                    defer writer.Close()
                    return resp.Body(writer)
                {{else if eq .NameTag "Text" -}}
                    w.Header().Set("Content-Type", {{if .HasFixedContentType}}{{.ContentType | toGoString}}{{else}}resp.ContentType{{end}})
                    w.WriteHeader({{$status}})
                    _, err := w.Write([]byte(fmt.Sprint(resp.Body)))
                    return err
                {{else -}}
                    w.Header().Set("Content-Type", {{if .HasFixedContentType}}{{.ContentType | toGoString}}{{else}}resp.ContentType{{end}})
                    w.WriteHeader({{$status}})
                    if closer, ok := resp.Body.(io.ReadCloser); ok {
                        defer closer.Close()
                    }
                    _, err := io.Copy(w, resp.Body)
                    return err
                {{end -}}
            }
        {{end}}

        {{if eq 0 (len .Contents) -}}
            type {{$opid}}{{$statusCode}}Response struct {
                {{if $hasHeaders -}}
                    Headers {{if $isRef}}{{$ref}}{{else}}{{$opid}}{{$statusCode}}{{end}}ResponseHeaders
                {{end -}}
                Body any
            }

            func (resp {{$opid}}{{$statusCode}}Response) Visit{{$opid}}Response(w http.ResponseWriter) error {
                {{range $headers -}}
                    {{if .IsOptional -}}
                        if resp.Headers.{{.GoName}} != nil {
                            w.Header().Set("{{.Name}}", fmt.Sprint(*resp.Headers.{{.GoName}}))
                        }
                    {{else -}}
                        w.Header().Set("{{.Name}}", fmt.Sprint(resp.Headers.{{.GoName}}))
                    {{end -}}
                {{end -}}
                if resp.Body == nil {
                    return response.WriteOK(w, {{$status}})
                }
                return response.WriteData(w, {{$status}}, resp.Body)
            }
        {{end}}
    {{end}}
{{end}}{{end}}

// StrictServerInterface represents all server handlers.
type StrictServerInterface interface {
{{range .}}{{if not .IsAlias}}{{.SummaryAsComment .OperationId }}
// ({{.Method}} {{.Path}})
{{$opid := .OperationId -}}
{{$opid}}(ctx context.Context, request {{$opid | ucFirst}}RequestObject) ({{$opid | ucFirst}}ResponseObject, error)
{{end}}{{end}}{{/* range . */ -}}
}
