# ECS 部署的 .env 示例：复制为部署目录的 .env 后按实际填写
# 变量含义见 docs/platform-conventions.md §9 与 TEMPLATE_PLAN.md §10；DATABASE_URL、REDIS_URL 由 docker-compose.ecs.yaml 组装

# 部署
APP_PORT=3000
RUN_SEEDS=false
DATABASE_USERNAME=root
# 拼进 DATABASE_URL，只用 URL 安全字符（字母、数字、- . _ ~）
DATABASE_PASSWORD=change-me
DATABASE_NAME=api

# 服务
OTEL_SERVICE_NAME=go-template
APP_DEFAULT_LOCALE=zh
APP_FRONTEND_URL=https://app.example.com
DOCS_ENABLED=false
SHUTDOWN_TIMEOUT=20s
LOG_LEVEL=info
LOG_FORMAT=json
DATABASE_SCHEMA=public
DATABASE_MAX_CONNS=20
WORKER_DATABASE_MAX_CONNS=10

# 认证：签发服务设 AUTH_SIGNING_KEY（make keys 生成），验证服务改设 AUTH_JWKS_URL
AUTH_ISSUER=go-template
AUTH_AUDIENCE=api
AUTH_SIGNING_KEY=
AUTH_VERIFY_KEYS=
AUTH_JWKS_URL=
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
PASSWORD_HASH_CONCURRENCY=2

# 邮件与短信：签发服务生产必填
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=no-reply@example.com
SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 第三方登录：凭据齐全的 provider 才启用
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
WECHAT_APP_APP_ID=
WECHAT_APP_APP_SECRET=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 文件：local 驱动需要 FILE_URL_SECRET（至少 32 字符）
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
FILE_URL_SECRET=
FILE_URL_TTL=1h

# 数据保留
ACCOUNT_DELETION_GRACE=168h
AUDIT_RETENTION=4320h

# 种子：生产只在没有 active 管理员时创建
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# HTTP
BODY_LIMIT=1MiB
CORS_ORIGINS=https://app.example.com
TRUSTED_PROXIES=1
RATE_LIMIT_ENABLED=true

# 可观测性：prometheus 模式需要 METRICS_TOKEN 或 METRICS_PORT
OTEL_METRICS_EXPORTER=prometheus
OTEL_TRACES_EXPORTER=none
OTEL_LOGS_EXPORTER=none
METRICS_TOKEN=
METRICS_PORT=
WORKER_METRICS_PORT=9464
SENTRY_DSN=
