// one runs a query returning a single {{.name}}; found is false when it returned no row.
func (r *{{.Plural}}) one(ctx context.Context, op string, fn func(q *sqlcgen.Queries) (*sqlcgen.{{.Name}}, error)) (*entity.{{.Name}}, bool, error) {
	var out *entity.{{.Name}}

	err := r.db.queries(ctx, func(q *sqlcgen.Queries) error {
		row, err := fn(q)
		if err != nil {
			return err
		}

		out = {{.name}}Of(row)

		return nil
	})

	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return nil, false, nil
	case err != nil:
		return nil, false, fmt.Errorf("postgres: %s {{.name}}: %w", op, err)
	}

	return out, true, nil
}

