// Create implements repo.{{.Plural}}.
func (r *{{.Plural}}) Create(ctx context.Context, n *entity.{{.Name}}) (*entity.{{.Name}}, error) {
	var out *entity.{{.Name}}

	err := r.db.queries(ctx, func(q *sqlcgen.Queries) error {
		row, err := q.Create{{.Name}}(ctx, sqlcgen.Create{{.Name}}Params{ID: n.ID, OwnerSub: n.OwnerSub, Title: n.Title, Content: n.Content})
		if err != nil {
