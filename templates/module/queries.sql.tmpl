-- name: Create{{.Name}} :one
INSERT INTO {{.name}} (id, owner_sub, title, content)
VALUES (@id, @owner_sub, @title, @content)
RETURNING *;

-- name: Get{{.Name}} :one
SELECT *
FROM {{.name}}
WHERE id = @id AND owner_sub = @owner_sub AND deleted_at IS NULL;

-- name: List{{.Plural}} :many
SELECT *
FROM {{.name}}
WHERE owner_sub = @owner_sub
  AND deleted_at IS NULL
  AND (sqlc.narg('after_created_at')::timestamptz IS NULL
       OR (created_at, id) < (sqlc.narg('after_created_at')::timestamptz, sqlc.narg('after_id')::uuid))
ORDER BY created_at DESC, id DESC
LIMIT @row_limit;

-- name: Update{{.Name}} :one
UPDATE {{.name}}
SET title = coalesce(sqlc.narg('title'), title),
    content = coalesce(sqlc.narg('content'), content),
    updated_at = now()
WHERE id = @id AND owner_sub = @owner_sub AND deleted_at IS NULL
RETURNING *;

-- name: SoftDelete{{.Name}} :execrows
UPDATE {{.name}}
SET deleted_at = now()
WHERE id = @id AND owner_sub = @owner_sub AND deleted_at IS NULL;

-- name: PurgeOwner{{.Plural}} :exec
DELETE FROM {{.name}}
WHERE owner_sub = @owner_sub;
