<!doctype html>
<html lang="{{.Lang}}">
<head><meta charset="utf-8"><title>{{.Subject}}</title></head>
<body style="font-family: sans-serif; line-height: 1.6; color: #1f2328;">
  <p>{{.Greeting}}</p>
  <p>{{.Body}}</p>
  <p><a href="{{.Link}}" style="display: inline-block; padding: 8px 16px; background: #0969da; color: #ffffff; text-decoration: none; border-radius: 6px;">{{.Action}}</a></p>
  <p style="word-break: break-all;">{{.Link}}</p>
  <p style="color: #59636e;">{{.Expires}}<br>{{.Ignore}}</p>
</body>
</html>
