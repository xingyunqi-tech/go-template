APP_ENV=development
APP_PORT=3000
APP_DEFAULT_LOCALE=zh
APP_FRONTEND_URL=http://localhost:5173
DOCS_ENABLED=true
SHUTDOWN_TIMEOUT=20s

LOG_LEVEL=debug
LOG_FORMAT=text

DATABASE_URL=postgresql://root:secret@localhost:5432/api?sslmode=disable
DATABASE_SCHEMA=public
DATABASE_MAX_CONNS=20
WORKER_DATABASE_MAX_CONNS=10

REDIS_URL=

AUTH_ISSUER=go-template
AUTH_AUDIENCE=api
AUTH_SIGNING_KEY=
AUTH_VERIFY_KEYS=
AUTH_JWKS_URL=
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
PASSWORD_HASH_CONCURRENCY=2

SMTP_URL=
MAIL_FROM=no-reply@example.com

# log 只把验证码写进日志，用于本地开发；签发服务生产必须为 aliyun
SMS_PROVIDER=log
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com

# 第三方登录：凭据齐全的 provider 才启用
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
WECHAT_APP_APP_ID=
WECHAT_APP_APP_SECRET=
WECHAT_API_BASE=https://api.weixin.qq.com
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

ACCOUNT_DELETION_GRACE=168h
AUDIT_RETENTION=4320h

# 文件：local 存本机目录（getFileContent 签名地址，生产需 FILE_URL_SECRET），s3 为预签名地址
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/files
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
FILE_URL_SECRET=
FILE_URL_TTL=1h

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

BODY_LIMIT=1MiB
CORS_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=0
RATE_LIMIT_ENABLED=true

METRICS_TOKEN=
METRICS_PORT=
WORKER_METRICS_PORT=9464

OTEL_SERVICE_NAME=go-template
OTEL_TRACES_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_METRICS_EXPORTER=prometheus
SENTRY_DSN=
